#!/bin/bash
#PBS -A argonne_tpc
#PBS -q debug
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:eagle
#PBS -N csl_eval
#PBS -j oe

# Serve base + LoRA on one node with vLLM, generate CSL for the held-out kernels
# (no Cerebras SDK), and proxy-score fine-tuned vs base vs commercial artifact.
#
# Pipeline smoke (cheap, validates the whole flow end-to-end):
#   qsub -q debug -l walltime=00:40:00 -v \
#     BASE_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct,TP=1,\
#     ADAPTER=/eagle/argonne_tpc/lyb/runs/csl_sft_smoke/final,\
#     OUTDIR=/eagle/argonne_tpc/lyb/runs/eval_smoke,MAX_PER_KERNEL=2 scripts/pbs/csl_eval.pbs
#
# Real eval (Qwen3-32B, needs TP=4):
#   qsub -q preemptable -l walltime=02:00:00 -v \
#     BASE_MODEL=Qwen/Qwen3-32B,TP=4,\
#     ADAPTER=/eagle/argonne_tpc/lyb/runs/csl_sft_qwen3_v1/final,\
#     OUTDIR=/eagle/argonne_tpc/lyb/runs/eval_qwen3,MAX_PER_KERNEL=8 scripts/pbs/csl_eval.pbs

cd "$PBS_O_WORKDIR"
PROJ=/eagle/argonne_tpc/lyb/projects/llm-hls
WORKTREE=/eagle/argonne_tpc/lyb/xkernel-v1_0/code_translation
DATA=/eagle/argonne_tpc/lyb/data/csl_sft

source "$PROJ/scripts/env/env_llmhls.sh"
# gemma-4 needs the newer cu129 stack for serving; Qwen3/Qwen2.5 serve fine on llmhls.
if [ -n "${USE_G4_ENV:-}" ]; then
  deactivate 2>/dev/null || true
  source /eagle/argonne_tpc/lyb/envs/llmhls_g4/bin/activate
  export CUDA_HOME=/soft/compilers/cudatoolkit/cuda-12.9.1
  export LD_LIBRARY_PATH=$CUDA_HOME/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
  export PATH=$CUDA_HOME/bin:$PATH
fi
export HF_HUB_OFFLINE=1

BASE_MODEL=${BASE_MODEL:-Qwen/Qwen3-32B}
ADAPTER=${ADAPTER:?set ADAPTER=/path/to/sft/final}
SERVED_NAME=${SERVED_NAME:-csl-sft}
TP=${TP:-4}
# MAXLEN must be <= the base model's max_position_embeddings (Qwen3=40960, Qwen2.5-Coder-1.5B=32768).
MAXLEN=${MAXLEN:-40960}
# MAX_TOKENS caps completion so prompt(~up to 34K tok)+completion stays under MAXLEN.
MAX_TOKENS=${MAX_TOKENS:-6000}
TEST_PROMPTS=${TEST_PROMPTS:-$DATA/test_prompts.jsonl}
OUTDIR=${OUTDIR:-/eagle/argonne_tpc/lyb/runs/eval_qwen3}
MAX_PER_KERNEL=${MAX_PER_KERNEL:-8}
mkdir -p "$OUTDIR"

# --- start vLLM: base model (under its HF name) + LoRA adapter (under SERVED_NAME) ---
vllm serve "$BASE_MODEL" \
  --enable-lora --max-lora-rank ${MAX_LORA_RANK:-64} --lora-modules "$SERVED_NAME=$ADAPTER" \
  --tensor-parallel-size "$TP" --host 127.0.0.1 --port 8000 \
  --max-model-len "$MAXLEN" --gpu-memory-utilization "${GPU_UTIL:-0.90}" \
  > "$OUTDIR/vllm_server_${PBS_JOBID%%.*}.log" 2>&1 &
VLLM_PID=$!
trap 'kill $VLLM_PID 2>/dev/null' EXIT

echo "waiting for vLLM to load $BASE_MODEL (+LoRA $SERVED_NAME) ..."
for i in $(seq 1 120); do
  if curl -s --max-time 5 http://127.0.0.1:8000/v1/models | grep -q "$SERVED_NAME"; then
    echo "vLLM ready after ~$((i*10))s"; READY=1; break
  fi
  kill -0 $VLLM_PID 2>/dev/null || { echo "vLLM died — see $OUTDIR/vllm_server log"; exit 1; }
  sleep 10
done
[ "${READY:-0}" = 1 ] || { echo "vLLM not ready after 20 min"; exit 1; }

# --- generate for the fine-tuned adapter and the base model ---
CLIENT_PY=/eagle/argonne_tpc/lyb/envs/llmhls/bin/python   # has openai even under USE_G4_ENV
$CLIENT_PY "$PROJ/scripts/gen_csl_heldout.py" \
  --test-prompts "$TEST_PROMPTS" --base-url http://127.0.0.1:8000/v1 \
  --model "$SERVED_NAME" --out "$OUTDIR/gen_finetuned.jsonl" \
  --max-per-kernel "$MAX_PER_KERNEL" --max-tokens "$MAX_TOKENS"
$CLIENT_PY "$PROJ/scripts/gen_csl_heldout.py" \
  --test-prompts "$TEST_PROMPTS" --base-url http://127.0.0.1:8000/v1 \
  --model "$BASE_MODEL" --out "$OUTDIR/gen_base.jsonl" \
  --max-per-kernel "$MAX_PER_KERNEL" --max-tokens "$MAX_TOKENS"

# --- proxy score (pure-python harness validators; needs the worktree on PYTHONPATH) ---
PYTHONPATH=$WORKTREE $CLIENT_PY "$PROJ/scripts/score_csl_proxy.py" \
  --gen finetuned="$OUTDIR/gen_finetuned.jsonl" \
  --gen base="$OUTDIR/gen_base.jsonl" \
  --out-dir "$OUTDIR" --export-tar

echo "=== eval done -> $OUTDIR/scoreboard.json ==="
